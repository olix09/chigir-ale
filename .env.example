# ==============================================================================
# Chigir Ale - Environment Configuration Template
# ==============================================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chigir_ale?schema=public"

# Authentication & Security
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"
APP_URL="http://localhost:3000"

# Storage (S3-Compatible Object Storage)
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="chigir-ale-evidence"
STORAGE_ACCESS_KEY="placeholder-access-key"
STORAGE_SECRET_KEY="placeholder-secret-key"

# Maps & Location Intelligence
MAP_API_KEY="placeholder-map-api-key"

# AI & Voice Decision Support
AI_API_KEY="placeholder-ai-api-key"
VOICE_API_KEY="placeholder-voice-api-key"

# Notifications (Push & Email)
PUSH_CONFIG="placeholder-push-service-config"
EMAIL_CONFIG="placeholder-smtp-or-provider-config"
